---
import Layout from "@/layouts/layout.astro";

import { PatternLibrary } from "@/features/engine";
import { CanvasArea } from "@/features/canvas";
import { Properties } from "@/features/properties";
---

<Layout>
  <div class="flex h-screen overflow-hidden bg-background text-foreground selection:bg-primary/20">
    <aside aria-label="Primary Navigation" class="h-full">
      <PatternLibrary client:load />
    </aside>

    <div id="main-canvas" class="flex flex-1 overflow-hidden">
      <section aria-label="Design Canvas" class="contents">
        <CanvasArea client:visible />
      </section>

      <aside
        aria-label="Properties Inspector"
        class="flex w-64 flex-col border-l border-white/10 bg-background/50 p-4 backdrop-blur-sm"
      >
        <Properties client:visible />
      </aside>
    </div>
  </div>
</Layout>